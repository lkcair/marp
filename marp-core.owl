    <rdf:first rdf:resource="https://w3id.org/marp#restsOn"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb2c90a398feb10bf11ad62d2d6fc1b28a3ba039c15df1667194592d742a481cbb7">
