    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#routedTo"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/prov#Agent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb203c7228dfb9989b7936befeb5279b07c88b0849628eacda52635aff1b3680790">
    <rdf:first rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <rdf:rest rdf:nodeID="cb1dbe202eaaa9694824c4616f3fdc6c6c81d22aae9daf21ae22387f9c850dc4712"/>
