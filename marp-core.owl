<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/marp#StochasticConfiguration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The configuration of a step that sampled from a distribution: the decoding parameters, the seed, and the number of samples drawn.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Stochastic configuration</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/marp#ModelConfiguration"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#ToolInvocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A step in which an agent called a tool, a function, an external service, or a data store, and received what it returned. The arguments are an entity the step used, the result is an entity it generated, and the tool is the software agent it names.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Tool invocation</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb28758da114af3c5e5b5d549eae9ff1d9d7d6ac819cd7f44466ff551208c0c2fbf"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/mls#Run">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/mls#"/>
    <rdfs:label>Run</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#AggregatedOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An output of a step that reconciled several agent outputs. Inferred.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Aggregated output</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/marp#AgentOutput"/>
    <owl:equivalentClass rdf:nodeID="cb2c90a398feb10bf11ad62d2d6fc1b28a3ba039c15df1667194592d742a481cbb7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#numericPrecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The arithmetic the weights and activations were served in.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#ModelConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>numeric precision</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#maxOutputTokens">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The output length limit of the request that produced the output.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#StochasticConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>maximum output tokens</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#EvidenceBundle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Everything the orchestration placed in front of one model invocation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Evidence bundle</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#MemoryRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A record kept in a store that outlives the run that reads or writes it. The store is a prov:Collection, and a newer record that replaces it is related by prov:wasRevisionOf.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Memory record</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb246cef7a12436f94bb5056bf72af84eea484c0b68f411c2320b46ec8a53a246aa"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#dependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:comment>The transitive closure of recorded derivation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>depends on</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/marp#mayDependOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#AffectedArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An entity that may depend on a suspect source. The impact reading: nothing reached is left out.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Affected artifact</rdfs:label>
    <owl:equivalentClass rdf:nodeID="cb1361c250437e0bdf51f572a6e8716b01cb31013634d45626a37746f4c12fa8d8b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#restsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>A dataset this entity ultimately rests on, reached by pushing the datum-to-dataset bridge back through the derivation closure.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>rests on</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <owl:propertyChainAxiom rdf:nodeID="cb2822cdf2d4f01fbf79a751e91d2c81e8ec6a8a69fb3c0ddd850c96b16e285cb92"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#Inference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A step that invoked a model. It records the configuration it used.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Inference</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb21fbcd1c8d094c539f1ff3ad5df42c6b21dc435b4e738f6ec9e80dcfe3a2d98e9"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/mls#Run"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#temperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The sampling temperature of the request that produced the output.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#StochasticConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>temperature</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cbd7c96744b860be374134b6eeace4a6009e3d5947219e59b3c009836ad1012775">
    <rdf:first rdf:nodeID="cb2b51c0f308c36869ab6d4d2b1ccd533467cdbb6536cb78afe6b6600177a25e6fd"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#ModelConfiguration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The model a step invoked, the parameters that governed the call, and the state of the stack that served it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Model configuration</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb389b0c770c2162cdc108fe26c7e61183f4b7c693811e7cb3f5e235e6a4e9e307b"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#modelVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The version of the model the configuration addresses, as the serving stack reports it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#ModelConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>model version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#topP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The nucleus sampling parameter of the request that produced the output.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#StochasticConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>top-p</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1361c250437e0bdf51f572a6e8716b01cb31013634d45626a37746f4c12fa8d8b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#mayDependOn"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/marp#SuspectSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#PromptTemplate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The reusable wording an evidence bundle was rendered from. It outlives the request and carries a version.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Prompt template</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#citesEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Evidence a rationale claims to rely on. Kept apart from every derivation property so the claim can be compared with the record.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#Rationale"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>cites evidence</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb3411dd37dfa75d126622331415bb19eaeb1f590174490fa2ccb5dab87dc95a3b6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/prov#Agent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#confidenceSignal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The value of the signal on which the dispatch was decided.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#RoutingDecision"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>confidence signal</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb192b1c9a6be0eeb72bd6d84adc385baacd1f844bf42e9fb5d187f2bff0e52d1e0">
    <rdf:first rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <rdf:rest rdf:nodeID="cb14cc6045457e56fb7ed7d9ff82178cfd6614d0010d137b416b5740ec97d274311"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#SuspectSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An entity an operator has marked as faulty, retracted, or compromised. The one assertion an impact analysis starts from.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Suspect source</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb2678f9df9cef56b6b33f3714696d1721de71e5836b1a36e85d2a7dd6ac22e87f0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#producedUnder"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/marp#SuspectModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#randomSeed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The seed a sampling step drew under, or the seed that governed the fitting of an estimator.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#ModelConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>random seed</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#onModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The model a configuration addresses.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#ModelConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>on model</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/mls#Model"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#Dataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/dcat"/>
    <rdfs:label>Dataset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#ExternalEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The record of a change the run made outside itself: a message sent, a file written, data disclosed to a service. It is attributed to the agent that carried it out.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>External effect</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb3411dd37dfa75d126622331415bb19eaeb1f590174490fa2ccb5dab87dc95a3b6"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#producedUnder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>A model this entity was produced under, directly or through anything it depends on.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>produced under</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/mls#Model"/>
    <owl:propertyChainAxiom rdf:nodeID="cb192b1c9a6be0eeb72bd6d84adc385baacd1f844bf42e9fb5d187f2bff0e52d1e0"/>
    <owl:propertyChainAxiom rdf:nodeID="cb1c5d8a80a8dbfc6556977feed906a6c3062517f9e315a35780509231f54dc3ef6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#consideredAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>An agent that was available to a routing decision.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#RoutingDecision"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>considered agent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#ImplicatedArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An entity the record states was derived from a suspect source. The blame reading: nothing is implicated the record does not support.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Implicated artifact</rdfs:label>
    <owl:equivalentClass rdf:nodeID="cb1f889e9284378a3d54e8f5932c694328286cbf2816322a5e811f146ecbbdddcd0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#sampleCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The number of concurrent samples the step drew under this configuration.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#StochasticConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>sample count</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#Claim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>One statement inside a generated artifact.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#renderedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The template a bundle was rendered from.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#EvidenceBundle"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>rendered from</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/marp#PromptTemplate"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#servingStack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The inference server and version that executed the step.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#ModelConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>serving stack</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#RecalledArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An entity whose lineage passes through a memory record, so part of what it rests on was written before the run that produced it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Recalled artifact</rdfs:label>
    <owl:equivalentClass rdf:nodeID="cb2909de79f91b44fdd3a048754967cfa686cdb043a7cc648526abec3ba65e8f99c"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1f889e9284378a3d54e8f5932c694328286cbf2816322a5e811f146ecbbdddcd0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#dependsOn"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/marp#SuspectSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#informedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:comment>The transitive closure of communication between steps: a step informed by another, directly or through a chain of steps, such as an analysis dispatched by a routing step.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>informed by</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#ReplayableInference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An inference whose configuration records a seed, so the request can be re-issued. Whether the response comes back identical is decided by the serving state the configuration also records.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Replayable inference</rdfs:label>
    <owl:equivalentClass rdf:nodeID="cbce82bb05ea2b4c1ae7d74368382bc0e4b9c2fc3f6932591e8131a553e25fbb88"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#hasRationale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The rationale that justifies an output or a claim.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>has rationale</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/marp#Rationale"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb13ca1ad8977b5453944d30356890ee75a40f322281af1bc8d42601bc98f48a5bd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#citesEvidence"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#drawnFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The dataset an ingested value came out of, a membership relation, so it does not refine prov:specializationOf.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#SourceDatum"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>drawn from</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/marp#restsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#AgentOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An artifact an agent produced for another agent or for the user.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Agent output</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#routedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>An agent a routing decision selected.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#RoutingDecision"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>routed to</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/marp#consideredAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#SuspectModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A model an operator has withdrawn or put in question. The one assertion a model recall starts from.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Suspect model</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/mls#Model"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1c93d720db105ef95f2b9df834c48963fee7e2407769c491517c573b74f77d2cd">
    <rdf:first rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#validAtTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The time in the world the content of a memory record is about. prov:generatedAtTime says when the record was written.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#MemoryRecord"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>valid at time</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cbce82bb05ea2b4c1ae7d74368382bc0e4b9c2fc3f6932591e8131a553e25fbb88">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="cb20928cd0c043795ea98b228c5532c05595c68410b753230d507d235f8fc3ad4c0"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasInformedBy">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/marp#informedBy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1db724f0a65127165fd0b97d05208198b79560d50aad7d41899fc3c6e1fc9c8ae">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#drawnFrom"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1c5d8a80a8dbfc6556977feed906a6c3062517f9e315a35780509231f54dc3ef6">
    <rdf:first rdf:resource="https://w3id.org/marp#dependsOn"/>
    <rdf:rest rdf:nodeID="cb100cd18e28a35cbb1e29330f65254d544ea34625c0408dd8ee857d566826647c7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#OrchestratedAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An agent the orchestration schedules. The services it calls, model endpoints and data sources, are plain software agents. Its function in a step is a prov:Role on the qualified association.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Orchestrated agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#aggregationRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The rule by which several outputs were reconciled. On a stochastic configuration for a step that reconciled its own samples, on the activity for a step that reconciled the outputs of several agents.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>aggregation rule</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1297bf0c00daef4c9152f383d1234f83d4cbfe1e7e291c493b6871688d2367d83">
    <rdf:first rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <rdf:rest rdf:nodeID="cb1c93d720db105ef95f2b9df834c48963fee7e2407769c491517c573b74f77d2cd"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#SourceDatum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A value the run ingested from outside: a feed record, a retrieved passage, a tool result. It names the dataset it was drawn from.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Source datum</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb1db724f0a65127165fd0b97d05208198b79560d50aad7d41899fc3c6e1fc9c8ae"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb100cd18e28a35cbb1e29330f65254d544ea34625c0408dd8ee857d566826647c7">
    <rdf:first rdf:resource="https://w3id.org/marp#producedUnder"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#mayDependOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:comment>The transitive closure of derivation together with availability: what an activity generated may depend on anything that activity used, or that a step informing it used.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>may depend on</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <owl:propertyChainAxiom rdf:nodeID="cb10f0ffb7ea29b151d69dc986ceaee465d1cfd1f5b841daf115d10e1f949084fe1"/>
    <owl:propertyChainAxiom rdf:nodeID="cb203c7228dfb9989b7936befeb5279b07c88b0849628eacda52635aff1b3680790"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#usedConfiguration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The configuration a model invocation ran under.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#Inference"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>used configuration</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/marp#ModelConfiguration"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#IrreversibleEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An external effect the deployment states it cannot undo.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Irreversible effect</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/marp#ExternalEffect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb275890d4115cf76f11eb0880df5638c0c270caa3a8633f213b540dbceabc0fe2e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#randomSeed"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#threshold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The threshold the signal was measured against when the dispatch was decided.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#RoutingDecision"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>threshold</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb1dbe202eaaa9694824c4616f3fdc6c6c81d22aae9daf21ae22387f9c850dc4712">
    <rdf:first rdf:resource="http://www.w3.org/ns/prov#used"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb2601f6534706fe0a83cd68618c8f4eb8c37a8f78b31d93a8f1d0c4b04836e1f9">
    <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#hadMember"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#aggregates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>An agent output a step reconciled with others.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>aggregates</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/marp#AgentOutput"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp/core">
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:created>
    <dcterms:creator>Lucas Kojo Chehuen</dcterms:creator>
    <dcterms:description xml:lang="en">The core module of MARP. Declares what any multi-agent AI run leaves behind at execution time: model invocations and their configuration, tool invocations, routing decisions, agent outputs and their reconciliation, rationales, ingested data and the datasets it came from, persistent memory, and the changes the run made outside itself. Closes derivation, availability, accountability, dataset dependence, and model dependence over W3C PROV, and defines the classes an audit reads from those closures.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-20</dcterms:modified>
    <dcterms:publisher>Federal University of Juiz de Fora</dcterms:publisher>
    <dcterms:title xml:lang="en">MARP core: runtime provenance of multi-agent AI systems</dcterms:title>
    <vann:preferredNamespacePrefix>marp</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/marp#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <owl:priorVersion rdf:resource="https://w3id.org/marp/core/6.0"/>
    <owl:versionIRI rdf:resource="https://w3id.org/marp/core/7.0"/>
    <owl:versionInfo>7.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/mls#Model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/mls#"/>
    <rdfs:label>Model</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#invokedTool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The tool a step called. A software agent, as a model endpoint is; the agent that made the call is the one associated with the step.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/marp#ToolInvocation"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>invoked tool</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb2909de79f91b44fdd3a048754967cfa686cdb043a7cc648526abec3ba65e8f99c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#dependsOn"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/marp#MemoryRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#RoutingDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A dispatch decided at run time: the agents selected, the candidates considered, the signal, and the threshold it was measured against.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Routing decision</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb33f00d400552459c9b27f9b16cad2c4fde23f3a4ea53f7b858f0a90be93cc3200"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#accountableAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>An agent associated with the activity that generated this entity or anything it depends on.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>accountable agent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <owl:propertyChainAxiom rdf:nodeID="cb1297bf0c00daef4c9152f383d1234f83d4cbfe1e7e291c493b6871688d2367d83"/>
    <owl:propertyChainAxiom rdf:nodeID="cb16a8741739ad288ce8ac0b6dfb5fea10f54629fb17b9fd33978b7c8ab8da806f8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb246cef7a12436f94bb5056bf72af84eea484c0b68f411c2320b46ec8a53a246aa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:nodeID="cb2601f6534706fe0a83cd68618c8f4eb8c37a8f78b31d93a8f1d0c4b04836e1f9"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/prov#Collection"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb389b0c770c2162cdc108fe26c7e61183f4b7c693811e7cb3f5e235e6a4e9e307b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#onModel"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/mls#Model"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb27ec2f25ab616529ecea763aef0c8d43fb4d36095c865cd266d9c32b83c8398a6">
    <rdf:first rdf:resource="https://w3id.org/marp#informedBy"/>
    <rdf:rest rdf:nodeID="cb16267fd3a3958f4b03154161291f1d024f91bf5b752beba9e7ce843dea9bb94a9"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/marp#dependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#ModelAffectedArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An entity produced under a suspect model, directly or through anything it depends on.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Model-affected artifact</rdfs:label>
    <owl:equivalentClass rdf:nodeID="cb2678f9df9cef56b6b33f3714696d1721de71e5836b1a36e85d2a7dd6ac22e87f0"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb28758da114af3c5e5b5d549eae9ff1d9d7d6ac819cd7f44466ff551208c0c2fbf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/marp#invokedTool"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/marp#Rationale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The justification an agent attached to an output, with the evidence it cites.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/marp/core"/>
    <rdfs:label>Rationale</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="cb13ca1ad8977b5453944d30356890ee75a40f322281af1bc8d42601bc98f48a5bd"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb16a8741739ad288ce8ac0b6dfb5fea10f54629fb17b9fd33978b7c8ab8da806f8">
    <rdf:first rdf:resource="https://w3id.org/marp#dependsOn"/>
    <rdf:rest rdf:nodeID="cb132239cdc0ccd58b1a0c2bb75080fa714d955f5e824e2dd2cb50a12accfd674cf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="cb16267fd3a3958f4b03154161291f1d024f91bf5b752beba9e7ce843dea9bb94a9">
    <rdf:first rdf:resource="http://www.w3.org/ns/prov#used"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
